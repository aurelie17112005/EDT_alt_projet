# Database Configuration (Render will provide DATABASE_URL automatically)
DATABASE_URL=postgres://user:password@localhost:5432/database_name

# Individual DB credentials (fallback for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emargement
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT & Session Secrets
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production

# CAS Authentication
CAS_SERVICE_URL=https://your-backend-url.onrender.com/api/auth/login-cas
CAS_URL=https://auth.univ-fcomte.fr/

# Server Port (Render provides this automatically)
PORT=3000

# MongoDB (if needed for legacy support)
MONGO_URI=mongodb://localhost:27017/emargement
